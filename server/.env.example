# Gemini key: needed to read notifications, answer questions and translate clauses. Get a key at https://aistudio.google.com/apikey
AI_API_KEY=replace_me
AI_MODEL=gemini-3.5-flash-lite
# Used only when AI_MODEL is overloaded (set to none to turn off)
# BACKUP_AI_MODEL=gemini-3.5-flash-lite
# Sarvam key: optional, turns on spoken questions and answers in Telugu, Hindi and English. Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Optional Sarvam overrides
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_SPEAKER=priya
CLIENT_ORIGIN=http://localhost:5173
PORT=8000
